# Server
NODE_ENV=development     #Valores: "development" || "production". Cambiar a "production" deshabilita el seeder y valida secrets.
PORT=3000
AUTH_ROUTE_PATH=sso
CODE_TTL_MS=120000                                               #Code de un único uso entregado a quienes consultan el SSO. 120000 = 2 minutos.
CREDENTIAL_TOKEN_TTL_MS=86400000                                 #TTL del link de credenciales de un solo uso. 86400000 = 24 horas.
CREDENTIAL_ENCRYPTION_KEY=genera_una_clave_hex_de_64_caracteres  # 32 bytes en hex. Generá con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_RESET_TOKEN_TTL_MS=86400000     #TTL del link de set/reset de contraseña. 86400000 = 24 horas.

# Links
ADMIN_PANEL_URL=http://localhost:5173       # Front-end panel de administración
SSO_BASE_URL=http://localhost:3000          #Url en la que está hosteado este back. Usadopara enviar el mail al cliente.

# PostgreSQL 
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sso_itapu

# JWT alumnos. Ambos distintos.
JWT_ACCESS_SECRET=cambia_este_secret_acceso
JWT_REFRESH_SECRET=cambia_este_secret_refresco
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h              #Duración máxima de inactividad antes de que el refresh expire
JWT_REFRESH_SESSION_MAX_DURATION=3d    #Duración absoluta máxima de una sesión, independientemente de la actividad

# JWT admins. Ambos distintos, y distintos a los colocados en alumnos.
JWT_ADMIN_ACCESS_SECRET=cambia_este_secret_admin_acceso
JWT_ADMIN_REFRESH_SECRET=cambia_este_secret_admin_refresco
JWT_ADMIN_ACCESS_EXPIRES_IN=15m
JWT_ADMIN_REFRESH_EXPIRES_IN=1d

# TOTP
TOTP_ENCRYPTION_KEY=genera_una_clave_hex_de_64_caracteres  # Generá con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Seeder
ADMIN_USERNAME_SEEDER=admin
ADMIN_PASSWORD_SEEDER=cambia_esta_password_min_8_caracteres

# Credenciales para ver la documentación
SWAGGER_USER=admin
SWAGGER_PASSWORD=cambia_esta_password_swagger

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password
MAIL_FROM=tu_correo@gmail.com


#Redis (usado para pending 2FA challenges y pending secrets de credenciales)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cambia_esta_password_redis

#TTL del challenge de 2FA pendiente en milisegundos (default: 180000 = 3 minutos)
PENDING_2FA_TTL_MS=180000

#Máximo de intentos fallidos de TOTP antes de invalidar el challenge
PENDING_2FA_MAX_ATTEMPTS=5

# Bloqueo por intentos de contraseña de un alumno (baja del padrón)
STUDENT_PASSWORD_MAX_ATTEMPTS=5          # Intentos de contraseña antes de bloquear al alumno
STUDENT_PASSWORD_LOCK_TTL_MS=900000      # Duración de la ventana y del bloqueo. 900000 = 15 minutos

# Límite de requests de baja por IP
STUDENT_DELETE_THROTTLE_LIMIT=10         # Máximo de requests de baja por IP en la ventana
STUDENT_DELETE_THROTTLE_TTL_MS=60000     # Ventana. 60000 = 1 minuto

# Límite general de requests por IP (endpoints sin límite propio)
THROTTLE_GLOBAL_LIMIT=30
THROTTLE_GLOBAL_TTL_MS=60000

# Cambio de email de alumnos
EMAIL_CHANGE_TOKEN_TTL_MS=3600000                # Vencimiento del link de confirmación. 3600000 = 1 hora
STUDENT_EMAIL_CHANGE_THROTTLE_LIMIT=10           # Máximo de pedidos de cambio de email por IP en la ventana
STUDENT_EMAIL_CHANGE_THROTTLE_TTL_MS=60000       # Ventana. 60000 = 1 minuto